# Long-lived Facebook Graph user token (starts with EAA). Bootstrap only —
# after the first run the live token is stored in token/.token.json.
IG_ACCESS_TOKEN=

# Instagram Business/Creator account ID (NOT "me", NOT the Facebook user id).
# Discover via list_pages() + get_instagram_account() — see docs/USAGE.md.
IG_NODE=

# Graph API version
IG_GRAPH_API_VERSION=v25.0

# Required for token exchange, auto-refresh, and webhook signature checks
FB_APP_ID=
FB_APP_SECRET=

# Meta webhook hub.verify_token (must match App Dashboard webhook settings)
IG_WEBHOOK_VERIFY_TOKEN=
